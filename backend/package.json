{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "author": "",
  "license": "ISC",
  "keywords": [],
  "main": "index.js",
  "scripts": {
    "dev": "tsx watch src/local.ts",
    "update-tag-colors": "tsx prisma/updateTagColors.ts",
    "start": "node dist/local.js",
    "build": "npx prisma generate && tsc && tsc-alias && cp -r src/generated dist/",
    "test": "vitest run",
    "check-git-hooks": "cd .. && node .secret-scan/secret-scan.js -- --check-git-hooks",
    "format": "npm run check-git-hooks && prettier --write .",
    "lint-fix": "npm run check-git-hooks && (eslint --fix --cache --report-unused-disable-directives . || true) && prettier --write .",
    "lint-check": "npm run check-git-hooks && eslint --cache --report-unused-disable-directives . && prettier --check .",
    "prepare": "test -n \"$VERCEL\" || (cd .. && husky)"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.3.0",
    "@prisma/client": "^7.3.0",
    "@supabase/supabase-js": "^2.93.3",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "http-errors": "^2.0.1",
    "pg": "^8.17.2"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^6.7.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "25.0.3",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.39.2",
    "husky": "^9.1.7",
    "nodemon": "^3.1.11",
    "prettier": "^3.7.4",
    "prisma": "^7.3.0",
    "supertest": "^7.3.1",
    "ts-node-dev": "^2.0.0",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3"
  }
}
